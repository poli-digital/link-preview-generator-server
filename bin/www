#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require("../app");
var debug = require("debug")("link-preview-generator:server");
var http = require("http");

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

// Proactively ensure Chrome is present (background, non-blocking) so the first
// fallback request doesn't wait on a download. No-op when the fallback is off or
// a system Chromium is configured.
if (process.env.PUPPETEER_FALLBACK !== "false") {
	try {
		require("../lib/puppeteerFallback").warmup();
	} catch (err) {
		console.warn(`Puppeteer warmup skipped: ${err.message}`);
	}
}

/**
 * Graceful shutdown: stop accepting connections, drain in-flight requests, and
 * close the optional Puppeteer browser so Kubernetes SIGTERM doesn't leak
 * processes or kill requests mid-flight.
 */
function shutdown(signal) {
	console.info(`Received ${signal}, shutting down gracefully...`);
	server.close(async () => {
		try {
			// Fallback is ON by default (opt out with PUPPETEER_FALLBACK=false), so
			// close the browser unless it was explicitly disabled.
			if (process.env.PUPPETEER_FALLBACK !== "false") {
				const { closeBrowser } = require("../lib/puppeteerFallback");
				await closeBrowser();
			}
		} catch (err) {
			console.error("Error during shutdown:", err);
		}
		process.exit(0);
	});
	// Force-exit if draining hangs.
	setTimeout(() => process.exit(1), 10000).unref();
}

process.on("SIGTERM", () => shutdown("SIGTERM"));
process.on("SIGINT", () => shutdown("SIGINT"));

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
	var port = parseInt(val, 10);

	if (isNaN(port)) {
		// named pipe
		return val;
	}

	if (port >= 0) {
		// port number
		return port;
	}

	return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
	if (error.syscall !== "listen") {
		throw error;
	}

	var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

	// handle specific listen errors with friendly messages
	switch (error.code) {
		case "EACCES":
			console.error(bind + " requires elevated privileges");
			process.exit(1);
			break;
		case "EADDRINUSE":
			console.error(bind + " is already in use");
			process.exit(1);
			break;
		default:
			throw error;
	}
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
	var addr = server.address();
	var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
	debug("Listening on " + bind);
}
